# Service configuration (see crates/infrastructure/src/config.rs)
SERVICE_NAME=iaop-integration-service
SERVICE_VERSION=0.1.0
ENVIRONMENT=local
BIND_ADDR=0.0.0.0:8080

# Optional persistence - omit to run without a database
# DATABASE_URL=postgres://iaop:iaop@localhost:5432/integration_db
# DATABASE_MAX_CONNECTIONS=10

# Request timeout
REQUEST_TIMEOUT_SECS=30

# Logging
RUST_LOG=info,iaop_integration_service=debug
